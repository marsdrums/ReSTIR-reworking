<jittershader name="through">
	<description>Pass through slab </description>
	<param name="velTex" type="int" default="0" />
	<param name="currPosTex" type="int" default="1" />
	<param name="prevPosTex" type="int" default="2" />
	<param name="norDepthTex" type="int" default="3" />
	<param name="MVP" type="mat4" state="MODELVIEW_PROJECTION_MATRIX" />
	<param name="textureMatrix0" type="mat4" state="TEXTURE0_MATRIX" />
	<param name="pos" type="vec3" state="POSITION" />
	<param name="uv" type="vec2" state="TEXCOORD" />
	<param name="texDim" type="vec2" state="TEXDIM0" />
	<param name="invV" type="mat4" state="VIEW_MATRIX" transform="INVERSE" />
	<language name="glsl" version="1.5">
		<bind param="velTex" program="fp" />
		<bind param="currPosTex" program="fp" />
		<bind param="prevPosTex" program="fp" />
		<bind param="norDepthTex" program="fp" />
		<bind param="MVP" program="vp" />
		<bind param="textureMatrix0" program="vp" />
		<bind param="pos" program="vp" />
		<bind param="uv" program="vp" />
		<bind param="texDim" program="fp" />
		<bind param="invV" program="fp" />
		<program name="vp" type="vertex"  >
<![CDATA[
#version 330 core

in vec3 pos;
in vec2 uv;

out jit_PerVertex {
	vec2 uv;
} jit_out;
uniform mat4 MVP;
uniform mat4 textureMatrix0;

void main(void) {
	gl_Position = MVP*vec4(pos, 1.);
	jit_out.uv = vec2(textureMatrix0*vec4(uv, 0., 1.));
}
]]>
</program>

<program name="fp" type="fragment"  >
<![CDATA[
#version 330 core
#define PLANE_DISTANCE_THRESHOLD 0.1

in jit_PerVertex {
	vec2 uv;
} jit_in;
layout (location = 0) out vec4 outColor;
layout (location = 1) out vec4 outPos;

uniform sampler2DRect velTex, currPosTex, prevPosTex, norDepthTex;
uniform vec2 texDim;
uniform mat4 invV;

void main(void) {

	vec2 vel = texture(velTex, jit_in.uv).xy;
	vec2 repUV = jit_in.uv - vel*texDim;
	vec3 currP = (invV * vec4(texture(currPosTex, jit_in.uv).xyz, 1.0)).xyz;
	outPos = vec4(currP, 1.0);
	vec3 prevP = texture(prevPosTex, repUV).xyz;
	vec3 nor = (invV * vec4(texture(norDepthTex, jit_in.uv).xyz, 0.0)).xyz;

	vec3  to_current    = currP - prevP;
    float dist_to_plane = abs(dot(to_current, nor));

    outColor = vec4(vel, float(dist_to_plane > PLANE_DISTANCE_THRESHOLD), 1.0);

}
]]>
</program>
	</language>
</jittershader>
